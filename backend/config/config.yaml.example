# 数据库配置
database:
  host: 127.0.0.1
  port: 5432
  name: pdf_rag
  user: postgres
  password: postgres
  pool_size: 10
  max_overflow: 20

# Ollama配置
ollama:
  host: 192.168.31.80
  port: 11434
  model: qwen3:14b
  timeout: 600
  temperature: 0.7
  max_tokens: 8192

# 嵌入模型配置
embedding:
  model: "nomic-embed-text"
  batch_size: 64
  max_length: 1024
  api_url: "http://192.168.31.80:11434"
  use_remote_api: true

# 文档处理配置 - 优化分片参数
document:
  chunk_size: 600      # 减小片段大小，更适合精确检索
  chunk_overlap: 100   # 减小重叠，避免冗余
  max_chunks_per_document: 200

# 向量检索配置
retrieval:
  top_k: 12
  similarity_threshold: 0.5
  rerank: true
  rerank_top_k: 8

# 日志配置
logging:
  level: INFO
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  file: "logs/pdf_rag.log" 